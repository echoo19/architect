<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  The only exception the hardened runtime needs: V8 compiles JavaScript, and the tool sandbox's
  QuickJS WebAssembly, into machine code as it runs. The app loads no native modules or unsigned
  libraries and writes no executable memory of its own, so nothing else is granted.
-->
<plist version="1.0">
  <dict>
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
  </dict>
</plist>
