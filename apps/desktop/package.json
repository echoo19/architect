{
  "name": "@architect/desktop",
  "productName": "Architect",
  "version": "0.3.4",
  "private": true,
  "type": "module",
  "description": "Turn a job you describe into an agent that runs on your own computer.",
  "author": "Jake Kang",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc -p tsconfig.node.json && tsc -p tsconfig.web.json && tsc -p e2e/tsconfig.json",
    "e2e": "electron-vite build && playwright test",
    "package": "electron-vite build && electron-builder --publish never",
    "e2e:packaged": "playwright test --config playwright.packaged.config.ts"
  },
  "dependencies": {
    "@architect/engine": "workspace:*",
    "@architect/shared": "workspace:*",
    "@architect/ui": "workspace:*",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@architect/cli": "workspace:*",
    "@architect/harness": "workspace:*",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.5"
  }
}
